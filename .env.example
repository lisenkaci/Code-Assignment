# Copy this file to .env and provide a real key. Never commit .env.
OPENAI_API_KEY=

# Route routine extraction, complex extraction, and synthesis independently.
CODE_ANALYZER_ROUTINE_MODEL=gpt-5.6-luna
CODE_ANALYZER_COMPLEX_MODEL=gpt-5.6-terra
CODE_ANALYZER_SYNTHESIS_MODEL=gpt-5.6-sol
CODE_ANALYZER_MAX_CONTEXT_TOKENS=32768
CODE_ANALYZER_RESERVED_OUTPUT_TOKENS=4096
CODE_ANALYZER_CHUNK_TOKEN_BUDGET=12000
CODE_ANALYZER_MAX_CONCURRENCY=4
CODE_ANALYZER_REQUEST_TIMEOUT_SECONDS=45
